# --- API (server) ---
PORT=4000
JWT_SECRET=use_a_long_random_string_in_production

# Google OAuth Web Client ID (same value as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Only these email domains may sign in (comma-separated for multiple)
ALLOWED_EMAIL_DOMAIN=your-school.edu
# ALLOWED_EMAIL_DOMAINS=student.school.edu,staff.school.edu

# Optional: if your school uses Google Workspace, require this hosted domain (hd claim)
# REQUIRE_GOOGLE_WORKSPACE_DOMAIN=your-school.edu

# Comma-separated browser origins allowed to call the API (your deployed site + local dev)
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Set to true in production to block password registration (Google only for new users)
# DISABLE_PASSWORD_REGISTER=true

# --- Frontend (Vite; must be prefixed VITE_) ---
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# If the API runs on a port other than 4000 in dev, point the SPA at it (no trailing slash):
# VITE_DEV_API_URL=http://localhost:4010

# Production: public URL of your API including /api path (omit in dev)
# VITE_API_BASE=https://your-api.onrender.com/api
